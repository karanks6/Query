  "schema_sql": "CREATE TABLE players (id INTEGER PRIMARY KEY, name TEXT NOT NULL, team TEXT NOT NULL); CREATE TABLE matches (id INTEGER PRIMARY KEY, player_id INTEGER NOT NULL, score INTEGER NOT NULL, match_date TEXT NOT NULL);",
  "seed_sql": "INSERT INTO players VALUES (1, 'Alice', 'Red'), (2, 'Bob', 'Blue'), (3, 'Charlie', 'Red'); INSERT INTO matches VALUES (1, 1, 100, '2023-01-01'), (2, 2, 150, '2023-01-02'), (3, 1, 120, '2023-01-03'), (4, 3, 90, '2023-01-04'), (5, 2, 200, '2023-01-05');",
