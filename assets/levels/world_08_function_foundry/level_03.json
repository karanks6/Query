  "hints": [
    {
      "tier": "nudge",
      "content": "Use WITH cte_name AS (...) to create a temporary result set."
    },
    {
      "tier": "partial_reveal",
      "content": "Check your syntax.",
      "code_snippet": ""
    },
    {
      "tier": "full_solution",
      "content": "Here is the answer:",
      "code_snippet": "WITH PlayerTotals AS (SELECT player_id, SUM(score) AS total_score FROM matches GROUP BY player_id) SELECT player_id, total_score FROM PlayerTotals WHERE total_score > 200;"
